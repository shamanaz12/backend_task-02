PORT=5000
# Long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Secret code that lets someone register as an event ORGANIZER. Leave empty to disable.
ORGANIZER_CODE=change-me-organizer-code
# Optional: SQLite file location (default ./data/events.db)
# DB_PATH=./data/events.db
